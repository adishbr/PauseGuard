# PauseGuard V4.1 — Example Environment Configuration (NO SECRETS)
# Copy values into local environment variables as needed. Do not commit real credentials.

# --- Frontend (Vite) ---
# Set to "true" to connect React to FastAPI (/api/v2) instead of Vite mock middleware (/__pauseguard/demo)
VITE_USE_REAL_BACKEND=false
# Local FastAPI backend target for Vite dev proxy (loopback only)
PAUSEGUARD_BACKEND_URL=http://127.0.0.1:8000

# --- Backend (FastAPI) ---
# Must be "local" or "test" for offline/mock prototype operation
PAUSEGUARD_ENVIRONMENT=local
PAUSEGUARD_MODE=mock
# Explicit opt-in for synthetic demo session issuance on loopback (/api/v2/demo/session)
PAUSEGUARD_ALLOW_DEMO_AUTH=false
PAUSEGUARD_ALLOW_DEMO_ADMIN=false

# --- Optional Disposable PostgreSQL (Local / CI Testing Only) ---
# Use only a disposable local or ephemeral test database. Never use production credentials.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/pauseguard_test

# --- Optional Razorpay Test Mode Sandbox (Server-Side Only, Test Keys rzp_test_* Only) ---
# Variable names must match backend/app/integrations/razorpay_sandbox.py.
# PAUSEGUARD_RAZORPAY_TEST_ENABLED=true
# RZP_TEST_KEY_ID=rzp_test_placeholder
# RZP_TEST_KEY_SECRET=placeholder_secret
# RZP_TEST_WEBHOOK_SECRET=placeholder_webhook_secret

