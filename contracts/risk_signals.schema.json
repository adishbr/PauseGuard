{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskSignals",
  "type": "object",
  "required": [
    "schema_version",
    "data_environment",
    "model_name",
    "model_version",
    "generated_at",
    "evaluation_latency_ms",
    "evaluation_status",
    "degraded_reasons",
    "payment_id",
    "payer_id",
    "beneficiary_id",
    "amount_paise",
    "advisory_score",
    "calibrated_fraud_probability",
    "calibration_caveat",
    "suggested_caution_level",
    "reason_codes",
    "behavioral",
    "velocity",
    "registry",
    "mule_graph",
    "transcript",
    "can_authorize_payment",
    "can_execute_payment",
    "advisory_only"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "data_environment": {
      "type": "string",
      "enum": ["synthetic_lab", "verified_production"]
    },
    "model_name": { "type": "string" },
    "model_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "evaluation_latency_ms": { "type": "number", "minimum": 0.0 },
    "evaluation_status": {
      "type": "string",
      "enum": ["complete", "degraded", "timeout", "missing_inputs"]
    },
    "degraded_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "payment_id": { "type": "string" },
    "payer_id": { "type": "string" },
    "beneficiary_id": { "type": "string" },
    "amount_paise": { "type": "integer", "exclusiveMinimum": 0 },
    "advisory_score": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "calibrated_fraud_probability": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "calibration_caveat": { "type": "string" },
    "suggested_caution_level": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", "critical", null]
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "behavioral": { "$ref": "#/$defs/BehavioralSignal" },
    "velocity": { "$ref": "#/$defs/VelocitySignal" },
    "registry": { "$ref": "#/$defs/RegistrySignal" },
    "mule_graph": { "$ref": "#/$defs/MuleGraphSignal" },
    "transcript": { "$ref": "#/$defs/TranscriptCoercionSignal" },
    "can_authorize_payment": { "type": "boolean", "const": false },
    "can_execute_payment": { "type": "boolean", "const": false },
    "advisory_only": { "type": "boolean", "const": true }
  },
  "additionalProperties": false,
  "$defs": {
    "SignalProvenance": {
      "type": "object",
      "required": [
        "source_category",
        "data_origin",
        "calculation_method",
        "is_synthetic"
      ],
      "properties": {
        "source_category": {
          "type": "string",
          "enum": ["user_claim", "trusted_source", "model_inference"]
        },
        "data_origin": {
          "type": "string",
          "enum": [
            "user_input",
            "synthetic_fixture",
            "mock_ledger_history",
            "consented_audio_transcript",
            "mock_registry_table",
            "unavailable"
          ]
        },
        "calculation_method": {
          "type": "string",
          "enum": [
            "deterministic_lookup",
            "statistical_baseline",
            "heuristic_rule_engine",
            "graph_traversal",
            "nlp_regex_coercion",
            "unperformed"
          ]
        },
        "is_synthetic": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "BehavioralSignal": {
      "type": "object",
      "required": [
        "status",
        "profile_type",
        "baseline_median_paise",
        "deviation_multiple",
        "is_new_beneficiary",
        "prior_transfers_count",
        "provenance"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["evaluated", "uninitialized", "unavailable"]
        },
        "profile_type": {
          "type": ["string", "null"],
          "enum": ["personal", "professional", "small_business", "enterprise", null]
        },
        "baseline_median_paise": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "deviation_multiple": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "is_new_beneficiary": {
          "type": ["boolean", "null"]
        },
        "prior_transfers_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "provenance": { "$ref": "#/$defs/SignalProvenance" }
      },
      "additionalProperties": false
    },
    "VelocitySignal": {
      "type": "object",
      "required": [
        "status",
        "rolling_window_minutes",
        "attempts_in_window",
        "total_amount_paise_in_window",
        "structuring_suspected",
        "provenance"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["evaluated", "unavailable"]
        },
        "rolling_window_minutes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 1440
        },
        "attempts_in_window": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "total_amount_paise_in_window": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "structuring_suspected": {
          "type": ["boolean", "null"]
        },
        "provenance": { "$ref": "#/$defs/SignalProvenance" }
      },
      "additionalProperties": false
    },
    "RegistrySignal": {
      "type": "object",
      "required": [
        "check_status",
        "is_listed_high_risk",
        "registry_category",
        "provenance"
      ],
      "properties": {
        "check_status": {
          "type": "string",
          "enum": ["performed", "unavailable", "bypassed_in_lab"]
        },
        "is_listed_high_risk": {
          "type": ["boolean", "null"]
        },
        "registry_category": {
          "type": ["string", "null"]
        },
        "provenance": { "$ref": "#/$defs/SignalProvenance" }
      },
      "additionalProperties": false
    },
    "MuleGraphSignal": {
      "type": "object",
      "required": [
        "status",
        "in_degree_incoming_unique_payers",
        "hop_distance_to_flagged_mule",
        "cluster_risk_score",
        "provenance"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["evaluated", "unperformed", "unavailable"]
        },
        "in_degree_incoming_unique_payers": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "hop_distance_to_flagged_mule": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cluster_risk_score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "provenance": { "$ref": "#/$defs/SignalProvenance" }
      },
      "additionalProperties": false
    },
    "TranscriptCoercionSignal": {
      "type": "object",
      "required": [
        "status",
        "coercion_detected",
        "coercion_indicators",
        "suspected_prompt_injection",
        "provenance"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["evaluated", "unconsented", "absent", "unavailable"]
        },
        "coercion_detected": {
          "type": ["boolean", "null"]
        },
        "coercion_indicators": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suspected_prompt_injection": {
          "type": ["boolean", "null"]
        },
        "provenance": { "$ref": "#/$defs/SignalProvenance" }
      },
      "additionalProperties": false
    }
  }
}
